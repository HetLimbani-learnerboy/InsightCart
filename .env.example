# Local InsightCart environment variables
PROJECT_NAME="InsightCart"
PROJECT_VERSION="1.0.0"
API_PREFIX="/api/v1"
DESCRIPTION="AI Powered Review Detection API"

DEBUG=true
PORT=8000
HOST="0.0.0.0"

# Local MLflow tracking server
MLFLOW_TRACKING_URI="http://127.0.0.1:5000"
MLFLOW_TRACING_ENABLED=true

# Copy the pooled connection string from Neon > Project > Connect.
# Keep the full URL private; the backend adds sslmode=require for Neon when omitted.
DATABASE_URL="postgresql://USER:PASSWORD@HOST.neon.tech/DBNAME?sslmode=require"

# Backend-only Hugging Face Inference Providers configuration. Never use VITE_ prefixes.
HF_SENTIMENT_ENABLED=true
HF_TOKEN=your_huggingface_token_here
HF_SENTIMENT_MODEL=cardiffnlp/twitter-roberta-base-sentiment-latest
HF_SENTIMENT_TIMEOUT=30
# Maximum review length sent for sentiment inference, in characters.
HF_SENTIMENT_MAX_LENGTH=5000

# Optional DVC remote configuration
# DVC_REMOTE_NAME="localstorage"
# DVC_REMOTE_URL="../dvc_storage"


# Backend only: Groq review summarization
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
GROQ_TIMEOUT=60
REVIEW_SUMMARY_MAX_REVIEWS=1000
REVIEW_SUMMARY_BATCH_TOKENS=6000
REVIEW_SUMMARY_CACHE_TTL_HOURS=24

